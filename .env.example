DATABASE_URL=postgresql://user:password@localhost:5432/credium_db
MASTER_WALLET_SEED=

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

MAIN_WALLET_ADDRESS_EVM=0x4933CE990cF2702359fc2e7729e86315777fa980
MAIN_WALLET_ADDRESS_TRON=TLazXgujrQB9hMMxMB9Z5LmJaDeHeEjGkt

FBL_WALLET_ADDRESS_EVM=0x4933CE990cF2702359fc2e7729e86315777fa980
FBL_WALLET_ADDRESS_TRON=TLazXgujrQB9hMMxMB9Z5LmJaDeHeEjGkt
DIRECT_SWEEP_TO_FBL=false

# RPC URLs
ETH_RPC_URL=https://ethereum.publicnode.com
ETHEREUM_RPC_URL=https://ethereum.publicnode.com
TRON_RPC_URL=https://api.trongrid.io
TRON_API_KEY=

# Tron Gas Funder Configuration (for funding user wallets with TRX)
GAS_FUNDER_PRIVATE_KEY=
DEFAULT_GAS_AMOUNT=15
MIN_FUNDER_BALANCE=100
MAX_FUND_AMOUNT=20

# Ethereum Gas Funder Configuration (for funding user wallets with ETH)
ETH_GAS_FUNDER_PRIVATE_KEY=
DEFAULT_ETH_GAS_AMOUNT=0.01
MIN_ETH_FUNDER_BALANCE=0.5
MAX_ETH_FUND_AMOUNT=0.02

# Hot Wallet Addresses (where swept funds are sent)
HOT_WALLET_ADDRESS_TRON=
HOT_WALLET_ADDRESS_ETH=
# Fallback for both networks if specific addresses not set
HOT_WALLET_ADDRESS=

# Frontend URL for CORS
FRONTEND_URL=https://your-frontend-url.com

MINIMUM_DEPOSIT_USD=10
MONITOR_INTERVAL_SECONDS=60
AUTO_SWEEP_ENABLED=true
MIN_GAS_BALANCE_ETH=0.01
MIN_GAS_BALANCE_POLYGON=0.5
MIN_GAS_BALANCE_TRON=20

NODE_ENV=production
PORT=3002
LOG_LEVEL=info
